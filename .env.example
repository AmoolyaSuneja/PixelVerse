# Backend Environment Variables Template
# Copy this file to '.env' and fill in the values

# Port for the Express HTTP API Server
PORT=8080

# Port for the WebSocket Server (used locally)
# WS_PORT=8081

# JWT Secret for authenticating users
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pixelverse?retryWrites=true&w=majority
