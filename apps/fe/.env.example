# HTTP and WebSocket services used by the browser
VITE_BACKEND_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8081

# Optional but recommended for production video calls. Do not commit real
# credentials; use time-limited credentials from your TURN provider.
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=turn_username
VITE_TURN_CREDENTIAL=turn_credential
